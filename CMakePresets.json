{
  "version": 3,
  "configurePresets": [
    {
      "name": "mingw64-ucrt-debug",
      "displayName": "MinGW64 UCRT (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake/build/mingw64-ucrt-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/mingw64-ucrt.cmake"
      }
    },
    {
      "name": "mingw64-ucrt-release",
      "displayName": "MinGW64 UCRT (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake/build/mingw64-ucrt-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/mingw64-ucrt.cmake"
      }
    }
  ]
}
